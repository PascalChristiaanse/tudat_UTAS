{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "hidden": false,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "/home/pascal/miniconda3/envs/tudatpy-dev",
                "CMAKE_INSTALL_PREFIX": "/home/pascal/miniconda3/envs/tudatpy-dev",
                "Boost_NO_BOOST_CMAKE": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "TUDAT_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "default-no-tests",
            "inherits": "default",
            "description": "Build without tests",
            "cacheVariables": {
                "TUDAT_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "description": "Debug build configuration",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-no-tests",
            "inherits": "debug",
            "description": "Debug build configuration without tests",
            "cacheVariables": {
                "TUDAT_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "debug-with-tutorials",
            "inherits": "debug",
            "description": "Debug build with tutorials/applications",
            "cacheVariables": {
                "TUDAT_BUILD_TUDAT_TUTORIALS": "ON",
                "TUDAT_BUILD_TESTS": "OFF",
                "CMAKE_PREFIX_PATH": "/home/pascal/miniconda3/envs/tudatpy-dev",
                "CMAKE_INSTALL_PREFIX": "/home/pascal/miniconda3/envs/tudatpy-dev"
            }
        },
        {
            "name": "profile-with-tutorials",
            "inherits": "default",
            "description": "Profile build with tutorials/applications optimized for AMD uProf",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS": "-g -O0 -fno-omit-frame-pointer",
                "CMAKE_C_FLAGS": "-g -O0 -fno-omit-frame-pointer",
                "TUDAT_BUILD_TUDAT_TUTORIALS": "ON",
                "TUDAT_BUILD_TESTS": "OFF",
                "CMAKE_PREFIX_PATH": "/home/pascal/miniconda3/envs/tudatpy-dev",
                "CMAKE_INSTALL_PREFIX": "/home/pascal/miniconda3/envs/tudatpy-dev"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default-build",
            "hidden": false,
            "configurePreset": "default",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "default-build-no-tests",
            "configurePreset": "default-no-tests",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "debug-build",
            "configurePreset": "debug",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "debug-build-no-tests",
            "configurePreset": "debug-no-tests",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "debug-build-with-tutorials",
            "configurePreset": "debug-with-tutorials",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "profile-build-with-tutorials",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "all"
            ]
        },
        {
            "name": "profile-build-kplo-only",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "kplo_vlbi_estimation"
            ]
        },
        {
            "name": "simulate-Spacecraft-Tracking-Data",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "simulateSpacecraft"
            ]
        },
        {
            "name": "Estimate satellite state",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "estimateSatelliteState"
            ]
        },
        {
            "name": "Estimate state from FDOA",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "estimateSatelliteStateFDOA"
            ]
        },
        {
            "name": "TDOA simulated",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "estimateSatelliteStateTDOASimulated"
            ]
        },
        {
            "name": "Generalized Estimation",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "estimateGeneralized"
            ]            
        },
        {
            "name": "estimate using FDOA data",
            "configurePreset": "profile-with-tutorials",
            "jobs": 8,
            "targets": [
                "estimateSatelliteStateFDOA"
            ]
        },
        {
            "name": "clean",
            "configurePreset": "default",
            "jobs": 8,
            "targets": [
                "clean"
            ]
        }
    ]
}